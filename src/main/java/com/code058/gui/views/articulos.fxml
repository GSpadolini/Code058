<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<!--
  Archivo mínimo válido para Articulos.
  Asegúrate de que la ruta en el ClassLoader coincide con donde lo cargas:
  e.g. FXMLLoader(getClass().getResource("/com/code058/gui/views/articulos.fxml"))
-->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.code058.gui.controllers.ArticuloController"
      spacing="10" padding="10" prefWidth="640" prefHeight="480">

    <TableView fx:id="tablaArticulos" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="80"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="360"/>
            <TableColumn fx:id="colPrecio" text="Precio" prefWidth="160"/>
        </columns>
    </TableView>

    <Button text="Cargar artículos" onAction="#cargarArticulos" />

</VBox>

